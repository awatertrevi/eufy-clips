# /etc/eufy-clips.env (chmod 600). Use a dedicated Eufy guest account that only has the home(s) shared.
EUFY_USERNAME=
EUFY_PASSWORD=
EUFY_COUNTRY=NL
# Optional: comma-separated HomeBase serials; empty = every HomeBase 2 on the account.
EUFY_STATIONS=
# Shared secret for the web UI / Home Assistant iframe (>= 24 chars), e.g. `openssl rand -hex 24`.
EUFY_CLIPS_TOKEN=
EUFY_CLIPS_PORT=8787
EUFY_CLIPS_SYNC_MINUTES=5
EUFY_CLIPS_BACKFILL_DAYS=30
EUFY_CLIPS_CACHE_MB=800
